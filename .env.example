# MOM Server configuration - copy to .env and fill in.
# Every value here can also be set as a real environment variable.

# REQUIRED: shared secret clients must send as X-API-Key (or Bearer token)
API_KEY=change-me-to-a-long-random-string

# HuggingFace token for gated pyannote models (speaker diarization).
# 1) create free account at huggingface.co
# 2) accept license on the model pages for speaker-diarization-community-1
#    and its segmentation model
# 3) paste a read token below. Leave empty to run WITHOUT speaker labels
#    (transcript + minutes still work when ALLOW_NO_DIARIZATION=true).
HF_TOKEN=

# Storage location for uploads/outputs/database/models (relative or absolute)
DATA_DIR=data

# Models
WHISPER_MODEL=large-v3-turbo
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_FALLBACK_MODEL=pyannote/speaker-diarization-3.1
ALLOW_NO_DIARIZATION=true

# Ollama (minutes LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Hardware: auto|cuda|cpu and auto|int8_float16|int8|float16
DEVICE=auto
COMPUTE_TYPE=auto

# Limits & tuning
MAX_UPLOAD_MB=500
WORKER_CONCURRENCY=1
BATCH_SIZE_CHARS=3000
BATCH_OVERLAP_CHARS=200
